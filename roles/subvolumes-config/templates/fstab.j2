
#
# /etc/fstab
# This file has been created by Ansible @ {{ ansible_facts['hostname'] }}
#
# Accessible filesystems, by reference, are maintained under '/dev/disk/'.
# See man pages fstab(5), findfs(8), mount(8) and/or blkid(8) for more info.
#
# After editing this file, run 'systemctl daemon-reload' to update systemd
# units generated from this file.
#

# ---| Non-BTRFS mounts |--------------------------------------------
UUID={{ boot_part_UUID }} /boot                                     ext4   defaults                                                                                                        0 0
UUID={{ efi_part_UUID }}                            /boot/efi                                 vfat    defaults,uid=0,gid=0,umask=077,shortname=winnt                                                                  0 2

# ---| Mounts w/ ZSTD compression |----------------------------------
UUID={{ btrfs_part_UUID }} /                                         btrfs   compress=zstd:1,x-systemd.device-timeout=0,noatime,subvol=root                                                     0 0
UUID={{ btrfs_part_UUID }} /home                                     btrfs   compress=zstd:1,x-systemd.device-timeout=0,noatime,subvol=home                                                   0 0

# Dedicated subvolumes for fine-control for snapper's functionality:
UUID={{ btrfs_part_UUID }} /home/{{ username }}                          btrfs   compress=zstd:1,x-systemd.device-timeout=0,noatime,subvol={{ username }}                                                0 0

UUID={{ btrfs_part_UUID }} /home/{{ username }}/.var                     btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.var                   0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/devel                    btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.devel                 0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/Documents                btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.documents             0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/Music                    btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.music                 0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/Pictures                 btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.pictures              0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/Videos                   btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,subvol={{ username }}.videos                0 0

# ---| Mounts wo/ data COW eanbled |--------------------------------
UUID={{ btrfs_part_UUID }} /home/{{ username }}/.backups                 btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,nodatacow,subvol={{ username }}.backups     0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/.cache                   btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,nodatacow,subvol={{ username }}.cache       0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/.local/share/containers  btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,nodatacow,subvol={{ username }}.containers  0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/build                    btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,nodatacow,subvol={{ username }}.build       0 0
UUID={{ btrfs_part_UUID }} /home/{{ username }}/Downloads                btrfs   compress=zstd:1,x-systemd.device-timeout=0,x-gvfs-hide,x-gvfs-trash,noatime,nodatacow,subvol={{ username }}.downloads   0 0

# ---| Special mounts |----------------------------------------------
tmpfs                                     /tmp                                      tmpfs   defaults,nodev,nosuid,size={{ tmpfs_size }},noatime,mode=1777                                                                0 0

# ---| Additional mounts |-------------------------------------------
